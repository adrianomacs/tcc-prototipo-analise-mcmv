# Modelo de .streamlit/secrets.toml — COPIE para .streamlit/secrets.toml e
# preencha. O arquivo real está no .gitignore e não entra no repositório.
#
# A chave é OPCIONAL. Sem ela, o roteamento degrada para a euclidiana
# DECLARANDO a métrica — nada quebra; os requisitos de distância apenas
# continuam saindo NÃO AVALIÁVEL nos terrenos urbanos, por métrica insuficiente.
#
# Alternativa equivalente: a variável de ambiente ORS_API_KEY.
# O secrets.toml tem precedência.

[roteamento]

# OpenRouteService — ÚNICO provedor de rede do protótipo. Gratuito; cadastro em
# https://openrouteservice.org/dev/#/signup  →  confirmar e-mail  →  Request a
# token. Perfil usado: foot-walking.
#
# O Google Routes API está FORA do escopo. Não há chave do Google aqui.
ors_api_key = ""
